{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
        ],
        "ask": [
            "Bash(git commit*)"
        ],
        "deny": [
            "Bash(git revert*)",
            "Bash(git checkout*)",
            "Bash(git rebase*)"
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "ccstatusline",
        "padding": 0,
        "refreshInterval": 10
    }
}
